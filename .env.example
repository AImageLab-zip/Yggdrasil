DOCKER_SUFFIX=dev # or prod
ENV_FILE=.env

UID=$(id -u)
GID=$(id -g)

# Core app
SECRET_KEY=dev-secret-key-change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Optional proxy/HTTPS knobs
ENABLE_SSL=false
ENABLE_HTTPS_REDIRECT=false
FORCE_HTTPS=false
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Docker compose
WEB_EXTERNAL_PORT=9000
DB_EXTERNAL_PORT=4306
# MySQL (compose service: db)
MYSQL_DATABASE=yggdrasil
MYSQL_USER=yggdrasil
MYSQL_PASSWORD=yggdrasil_pass
MYSQL_ROOT_PASSWORD=root_pass_change_me

# Django DB settings
DB_NAME=yggdrasil
DB_USER=yggdrasil
DB_PASSWORD=yggdrasil_pass
DB_HOST=yggdrasil-db-$DOCKER_SUFFIX
DB_PORT=3306

# Email backend (console for dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=noreply@yggdrasil.local
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=noreply@yggdrasil.local
EMAIL_SENDER_EMAILS=noreply@yggdrasil.local

# Object storage (Garage, S3-compatible)
# For local dev, docker-compose.dev.yml runs a single-node Garage and
# overrides these with fixed dev credentials - see scripts/dev_bootstrap.sh.
OBJECT_STORAGE_ENDPOINT_URL=http://garage:3900
OBJECT_STORAGE_REGION=garage
OBJECT_STORAGE_ACCESS_KEY_ID=yggdrasil-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=yggdrasil-secret-key
OBJECT_STORAGE_BUCKET=yggdrasil
OBJECT_STORAGE_USE_SSL=false
OBJECT_STORAGE_VERIFY_SSL=false
OBJECT_STORAGE_ADDRESSING_STYLE=path
OBJECT_STORAGE_KEY_PREFIX=

# Distributed runner (Celery + Redis)
REDIS_PASSWORD=change-me-redis-password
REDIS_EXTERNAL_PORT=6379
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_BROKER_DB=0
# REDIS_RESULT_DB=0
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
CELERY_TIMEZONE=UTC
# The runner task enqueued by the web app (consumed by the runner-worker service).
RUNNER_TASK_NAME=yggdrasil.runner.process_job
RUNNER_DEFAULT_QUEUE=runner_dev
RUNNER_QUEUE_BY_MODALITY={"ios":"runner_ios_dev","bite_classification":"runner_bite_dev","cbct":"runner_cbct_dev"}
RUNNER_QUEUE_BY_PROJECT={}
RUNNER_API_TOKENS=dev-runner-token

# NOTE: the SLURM/SSH runner-worker config lives in a SEPARATE env file
# (.env.worker, see .env.worker.example) so the web container never gets the SSH key.
# Optional host-side paths for runner-worker bind mounts. The worker service is not on
# app-net and reaches Redis/API through .env.worker public URLs.
# SLURM_SSH_KEY_HOST=./secrets/slurm_ssh_key
# SLURM_KNOWN_HOSTS_HOST=./secrets/slurm_known_hosts

# Maintenance (celery beat + local worker; see docker-compose services
# 'beat' and 'maintenance-worker'). MUST NOT overlap any runner queue -
# settings.py refuses to start on collision.
MAINTENANCE_QUEUE=maintenance
# BACKUP_KEEP_DAILY=14
# BACKUP_KEEP_WEEKLY=8
# BACKUP_KEY_PREFIX=backups/mysql/

# Logging
LOG_LEVEL=DEBUG

# Optional reverse-proxy metadata
DOMAIN=
LETSENCRYPT_EMAIL=
# VIRTUAL_HOST=         # defaults to DOMAIN
# VIRTUAL_PORT=8000
# LETSENCRYPT_HOST=     # defaults to VIRTUAL_HOST/DOMAIN

# Laparoscopy worker (optional — falls back to request host if unset)
# WORKER_BASE_URL=
# WORKER_SESSION_READY_URL=
# WORKER_SESSION_PROMPT_URL=

# Live Whisper (required for microphone transcription)
WHISPER_WS_URL=wss://155.185.48.254:9097/ws
WHISPER_API_TOKEN=
WHISPER_CA_CERT=/app/certs/whisper-live.pem
# WHISPER_CONNECT_TIMEOUT=10

# App server (entrypoint.sh)
# AUTO_MIGRATE=1        # set 0 to skip 'migrate' on container start
# RUN_DEV_SERVER=0      # set 1 for Django dev server with auto-reload
# ASGI_WORKERS=4
# ASGI_KEEP_ALIVE=5

# --- Native DICOM (roadmap Phase 8) ------------------------------------------
# Key every stored DICOM UID is derived under: HMAC(this, original). Defaults to
# SECRET_KEY when blank, which works but ties the two rotations together. Rotating it
# renames every stored series and orphans the catalog -- a migration, not maintenance.
# There is deliberately no mapping table to recover from.
DICOM_UID_HMAC_KEY=

# Whether the public demo guest may read stored DICOM. Leave off until the nightly
# dicom_deidentification SystemCheck has been green for a while: the demo logs
# anonymous visitors in as a real user, so this makes stored series reachable without
# an account for any folder flagged is_demo.
DICOM_DEMO_ENABLED=False
