# ---------------------------------------------------------------------------
# Yggdrasil .gitignore
#
# Rule of thumb: ignore *specific* local junk, never whole directories that
# hold source. A blanket ignore plus an `!` allowlist means every new file in
# that directory silently vanishes from `git status`, which is how a script
# gets written, used and lost.
# ---------------------------------------------------------------------------

# --- Secrets and credentials -----------------------------------------------
.env
.env.dev
.env.prod
.env.worker
.env-zip-dgx
# A hand-made pre-change copy of .env is still a copy of .env.
.env.bak*
/secrets/
local_settings.py

# certs/ is TRACKED on purpose: it holds the pinned *public* certificate of the
# Live Whisper upstream (docs/setup.md records its fingerprint). A private key
# must never land there, so the shapes one arrives as are ignored rather than
# left to review.
certs/*.key
certs/*private*
certs/*privkey*

# --- Database dumps and backups --------------------------------------------
# Anchored: `backup*` unanchored would swallow common/backup_utils.py and any
# future <app>/backups/ package.
/backups/
/backup*
/prod_db.sql
*.sql
*.sql.gz
*.bak

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.python-version

# Packaging. Anchored: an unanchored `lib/` would swallow any <app>/lib/ package.
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.whl
*.egg
*.egg-info/
.installed.cfg
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# --- Tooling caches --------------------------------------------------------
.cache
.coverage
.coverage.*
.hypothesis/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.tox/
coverage.xml
htmlcov/
nosetests.xml
*.cover
.ipynb_checkpoints
celerybeat-schedule.*
*.sage.py

# --- Django runtime --------------------------------------------------------
*.log
*.pot
logs/
db.sqlite3
db.sqlite3-journal
media/
storage/
staticfiles/
collected-static/

# --- Frontend --------------------------------------------------------------
# The emitted bundle under static/vendor/cornerstone/ IS committed (CI rebuilds
# it and fails on any diff); only the toolchain's inputs are ignored.
node_modules/

# Large model weights fetched at runtime, not source.
static/vendor/transformers/models/
static/vendor/transformers/onnxruntime*/

# --- Local scripts ---------------------------------------------------------
# NOT a blanket `scripts/*` ignore: everything under scripts/ is source unless
# it is a downloaded binary or a scratch file.
scripts/.bin/
scripts/*.local.*
scripts/scratch_*

# --- Agent / editor local state --------------------------------------------
# CLAUDE.md and AGENTS.md are tracked project instructions, not local artifacts.
.claude/settings.local.json
.code-review-graph
ANALYSIS.md
MODULE_DESIGN.md
Trace-*.json
.tmp_trace_*.tsv
/Makefile

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
.history
*.swp
*.swo
*.iws
/out/
atlassian-ide-plugin.xml
sftp-config.json
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace
*.sublime-project

# .dockerignore was ignored before this cleanup and stays ignored, so the
# ignored set is unchanged by it. It is arguably a repo file that should be
# tracked; that is a separate decision.
.dockerignore

# --- OS -------------------------------------------------------------------
.DS_Store
Thumbs.db

# --- Archives and local working copies ------------------------------------
*.zip
/site

# External reference repo (browser panorex port source).
/seg2pano/

# Local working copies of cluster algorithms, deployed to
# /work/yggdrasil_workers/algo/<name>/ with their own lifecycle.
/laparoscopy-video/
/iop-compass/
# Weight files uploaded to algo/iop-compass/weights/ on the cluster.
/IOP_weights/
