# Runner worker env (Yggdrasil 2.0) — layered OVER .env for the runner-worker service.
#
# Only the dedicated runner worker (docker-compose 'runner-worker') reads this. The web
# container does NOT. Keep the SSH key and cluster config here so they never reach the
# web app. Object-storage creds are shared from .env (the worker signs data transfers,
# and injects those creds transiently into each cluster job — the cluster stores none).

# --- SSH into the cluster login node (worker is the only key holder) ---
SLURM_SSH_HOST=login.cluster.example
SLURM_SSH_PORT=22
SLURM_SSH_USER=yggdrasil
SLURM_SSH_KEY=/run/secrets/slurm_ssh_key      # mounted read-only into the worker

# --- Cluster paths ---
# One subdir per algo, each holding its own run.sbatch (see /work/yggdrasil_workers/README.md).
ALGO_BASE_DIR=/work/yggdrasil_workers/algo
SLURM_STAGE_DIR=/work/grana_maxillo/yggdrasil/stage            # shared-FS per-job workdirs

# --- Polling ---
SLURM_POLL_INTERVAL=15
SLURM_MAX_WALL_SECONDS=86400

# --- Worker -> web runner API ---
RUNNER_API_BASE_URL=http://web:8000/api       # internal URL of the web service
RUNNER_API_TOKEN=dev-runner-token             # one of RUNNER_API_TOKENS from .env
RUNNER_WORKER_ID=slurm-runner-1

# Queues this worker consumes (all runner queues from .env; used by the compose command).
RUNNER_QUEUES=runner_dev,runner_ios_dev,runner_bite_dev,runner_cbct_dev,runner_audio_dev
